{
  "name": "nerdfootball-ai-tests",
  "version": "1.0.0",
  "description": "Browser testing suite for NerdfootballAI",
  "scripts": {
    "test": "jest",
    "test:unit": "jest --testPathIgnorePatterns=smoke",
    "test:smoke": "jest tests/smoke.test.js",
    "analyze:firebase": "node scripts/migrate-firebase-config.js --analyze",
    "migrate:firebase": "node scripts/migrate-firebase-config.js --migrate",
    "migrate:firebase:dry": "node scripts/migrate-firebase-config.js --migrate --dry-run",
    "analyze:logs": "node scripts/migrate-console-logs.js --analyze",
    "migrate:logs": "node scripts/migrate-console-logs.js --migrate",
    "migrate:logs:core": "node scripts/migrate-console-logs.js --migrate --core-only",
    "migrate:logs:dry": "node scripts/migrate-console-logs.js --migrate --dry-run",
    "migrate:logs:core:dry": "node scripts/migrate-console-logs.js --migrate --core-only --dry-run",
    "claudify": "npm run analyze:firebase && npm run analyze:logs",
    "drift:check": "node scripts/prod-drift-check.js"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.24",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.1.2",
    "jest-puppeteer": "^10.0.1",
    "puppeteer": "^22.4.0",
    "ts-jest": "^29.1.2",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "cheerio": "^1.1.2",
    "dotenv": "^16.4.5",
    "firebase": "^12.2.1",
    "firebase-admin": "^13.5.0"
  },
  "jest": {
    "testEnvironment": "node",
    "modulePathIgnorePatterns": [
      "<rootDir>/.claude/",
      "<rootDir>/functions/node_modules/",
      "<rootDir>/backups/"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "<rootDir>/.claude/",
      "<rootDir>/backups/"
    ]
  }
}
